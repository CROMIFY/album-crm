NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo para rutas de servidor de confianza (webhooks/cron) — nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secreto configurado también en GitHub (Settings → Webhooks) para validar la firma del push.
GITHUB_WEBHOOK_SECRET=

# Secreto para proteger /api/cron/task-reminders y /api/cron/meeting-reminders
# (cabecera Authorization: Bearer <valor>).
CRON_SECRET=

# Envío de emails (tareas asignadas, recordatorios de vencimiento) vía Gmail SMTP.
# GMAIL_APP_PASSWORD se genera en https://myaccount.google.com/security → Contraseñas
# de aplicaciones (requiere verificación en 2 pasos activada en esa cuenta).
GMAIL_USER=cromifyes@gmail.com
GMAIL_APP_PASSWORD=

# URL pública de la app, usada para los enlaces dentro de los emails.
NEXT_PUBLIC_APP_URL=https://album-crm.vercel.app

# OAuth2 de Google Calendar/Meet (módulo de Reuniones). Se crean en
# https://console.cloud.google.com/apis/credentials como "ID de cliente de OAuth 2.0"
# (tipo Aplicación web), con http(s)://<NEXT_PUBLIC_APP_URL>/api/auth/google/callback
# como URI de redirección autorizado, y la Calendar API habilitada en el proyecto.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Módulo de Deploys (solo lectura del historial de despliegues).
# VERCEL_API_TOKEN: https://vercel.com/account/tokens → Create Token (scope: sin
# restricción de proyecto, para poder leer album-crm y album-landing-page).
VERCEL_API_TOKEN=
# RENDER_API_KEY: https://dashboard.render.com/u/settings#api-keys → Create API key
# (da acceso de lectura/escritura a toda la cuenta de Render; guárdalo como cualquier
# otro secreto, solo se usa aquí para leer los deploys de album-api).
RENDER_API_KEY=
